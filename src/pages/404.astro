---
import Base from "../layouts/Base.astro";
import "../styles/post.css";
---

<Base title="Nothing here" description="That page does not exist." bodyClass="single">
  <main>
    <section>
      <header>
        <h1>Nothing here</h1>
        <p class="topic">404</p>
      </header>
      <article>
        <div class="wrapper">
          <p>
            That address does not point at anything. The posts are all
            <a href="/">back on the front page</a>, floating around.
          </p>
        </div>
      </article>
    </section>
  </main>
</Base>
