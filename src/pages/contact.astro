---
import Base from "../layouts/Base.astro";
import "../styles/post.css";
---

<Base
  title="Get in Touch"
  description="Reach Aen Tan by email, LinkedIn or the contact form."
  bodyClass="single"
>
  <main>
    <section>
      <header>
        <p class="back"><a href="/">&#8592;back</a></p>
        <h1>Get in Touch</h1>
      </header>
      <article>
        <div class="wrapper">
          <p>
            I can be reached most effectively by
            <a href="mailto:hello@aentan.com">Email</a> and
            <a href="https://www.linkedin.com/in/aentan" rel="me">LinkedIn</a>.
            For bite-size design tidbits,
            <a href="https://twitter.com/aentan" rel="me">follow me on Twitter</a>.
          </p>
          <p>
            There is also a
            <a href="https://childishlab.typeform.com/to/i0Cpcn">short form</a>
            if that is easier.
          </p>
        </div>
      </article>
    </section>
  </main>
</Base>
